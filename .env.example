# ------------------------------------------------------------------------------
# REPOGUARD Frontend Configuration
# Copy this file to `.env` for local development. Never commit `.env` or secrets.
# ------------------------------------------------------------------------------

# Base URL for the external Python FastAPI REPOGUARD backend.
# Local FastAPI example: http://localhost:8000
VITE_REPOGUARD_API_BASE_URL="http://localhost:8000"

# HTTP request timeout in milliseconds for FastAPI API calls (minimum 2000).
VITE_REPOGUARD_API_TIMEOUT_MS="30000"

# ------------------------------------------------------------------------------
# Runtime Host Placeholders (Injected server-side only; never exposed to browser)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
